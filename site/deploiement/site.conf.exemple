# Configuration du site F4IOZ (Kotlin). Hors du paquet et hors de Git : /etc/f4ioz-site-kt/site.conf
# (propriétaire root, groupe f4ioz, droits 640). Format « clé = valeur », UTF-8.

# L'adresse publique (liens canoniques, sitemap, flux Atom) et la station.
url_base = https://f4ioz.fr
indicatif = F4IOZ
nom = Olivier
locator = JN18FS
fuseau = Europe/Paris
club = Radioclub F6KMX
lien.qrz = https://www.qrz.com/db/F4IOZ
lien.github = https://github.com/f4ioz

# Où écouter. Aperçu : 127.0.0.1:8001 (tunnel SSH). Derrière nginx sur une autre machine :
# l'adresse de cette machine (ou 0.0.0.0) et, dans « proxies », l'adresse de nginx.
ecoute = 127.0.0.1
port = 8001
# Les proxys dont on croit X-Forwarded-For / -Proto / -Host (nginx). Séparés par des virgules.
proxies = 127.0.0.1, ::1

# Les données du site (publications de SatMe, caches) et le contenu (articles, pages, albums, images).
donnees = /var/lib/f4ioz-site-kt
contenu = /var/lib/f4ioz-site-kt/contenu

# Wavelog, en lecture seule (facultatif) : l'adresse et une clé d'API « read only ».
# wavelog.stations : les profils à lire (identifiants séparés par des virgules) ; vide : tous.
wavelog.url =
wavelog.cle =
wavelog.stations =

# Publication depuis SatMe-PC : l'empreinte SHA-256 du jeton (« f4ioz-site jeton » la donne).
publication.jeton_sha256 =
# Une vidéo du journal au plus (Mo).
publication.video_max_mo = 200

# La page privée /admin : le mot de passe haché (« f4ioz-site mot-de-passe »). Vide : pas de page admin.
admin.mot_de_passe =

# Les éléments orbitaux : le serveur GP de SatMe (AMSAT si muet).
tle.serveur = https://gp.f4ioz.fr
# Les satellites des prochains passages de l'accueil (noms AMSAT ou numéros NORAD).
satellites.accueil = ISS, SO-50, RS-44, AO-7, PO-101, AO-91

# true : rien n'est demandé à Internet (essais).
hors_ligne = false
# Cookies « Secure » même en HTTP simple (laisser true derrière nginx en HTTPS).
cookies_securises = true
