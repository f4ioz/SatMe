<?xml version="1.0" encoding="utf-8"?>
<!--
     This file decides whether SatMe appears in the "open with" dialog when a
     cable is plugged in. Picking the app there also grants USB access, the
     only way to avoid a permission prompt on every connection.

     A missing ID fails silently: the app is simply absent from the list (this
     happened with a GS-232 emulator on an Arduino Mega 2560, vendor 0x2341).

     Values are decimal; the platform does not accept hex.
-->
<resources>
    <!-- =========================== Serial bridges ========================== -->

    <!-- Silicon Labs CP210x, 0x10C4. Product 0xEA60 is the IC-9700's internal
         UART, but CP2105/CP2108 expose other IDs and homebrew builds may use
         any of them, so the whole vendor is matched. -->
    <usb-device vendor-id="4292" />
    <!-- FTDI 0x0403 -->
    <usb-device vendor-id="1027" />
    <!-- Prolific PL2303 0x067B -->
    <usb-device vendor-id="1659" />
    <!-- WCH CH340 / CH341 / CH9102 0x1A86 — Arduino clones -->
    <usb-device vendor-id="6790" />
    <!-- Icom (generic) 0x0BC2 -->
    <usb-device vendor-id="3018" />
    <!-- Microchip MCP2200 / MCP2221 0x04D8 -->
    <usb-device vendor-id="1240" />

    <!-- ======================= Microcontroller boards ====================== -->
    <!-- GS-232 emulators almost always run on one of these. Official boards
         enumerate as CDC via their second chip (ATmega16U2 on the Mega 2560)
         and carry the board maker's vendor ID, not a serial bridge's. -->

    <!-- Arduino SA 0x2341: Uno, Mega 2560, Leonardo, Micro, Due… -->
    <usb-device vendor-id="9025" />
    <!-- Arduino (former arduino.org) 0x2A03 -->
    <usb-device vendor-id="10755" />
    <!-- Atmel / Microchip, boards in DFU bootloader 0x03EB -->
    <usb-device vendor-id="1003" />
    <!-- SparkFun 0x1B4F -->
    <usb-device vendor-id="6991" />
    <!-- Adafruit 0x239A -->
    <usb-device vendor-id="9114" />
    <!-- Van Ooijen / Teensy 0x16C0 -->
    <usb-device vendor-id="5824" />
    <!-- STMicroelectronics, STM32 CDC 0x0483 -->
    <usb-device vendor-id="1155" />
    <!-- LeafLabs Maple 0x1EAF -->
    <usb-device vendor-id="7855" />
    <!-- Raspberry Pi Pico 0x2E8A -->
    <usb-device vendor-id="11914" />
    <!-- Espressif, ESP32-S2/S3 native USB 0x303A -->
    <usb-device vendor-id="12346" />

    <!-- Catch-all: any device declaring the communications class at device
         level, whatever the vendor. Covers nearly every homebrew virtual
         serial port without chasing one more ID per new board. -->
    <usb-device class="2" />

    <!-- ========================== RTL-SDR dongles ========================== -->
    <!-- Realtek covers the vast majority of dongles; the others are rebadges
         that keep their own vendor ID. -->
    <!-- Realtek 0x0BDA -->
    <usb-device vendor-id="3034" />
    <!-- Terratec 0x0CCD -->
    <usb-device vendor-id="3277" />
    <!-- Dexatek 0x1D19 -->
    <usb-device vendor-id="7449" />
    <!-- ASUS / clones 0x1F4D -->
    <usb-device vendor-id="8013" />
    <!-- Compro 0x185B -->
    <usb-device vendor-id="6235" />
    <!-- Gtek / clones 0x1B80 -->
    <usb-device vendor-id="7040" />
    <!-- Hanftek 0x15F4 -->
    <usb-device vendor-id="5620" />
</resources>
