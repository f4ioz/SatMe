<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed because remote listening connects to a nearby phone
  by IP address on a LAN or hotspot: no domain name, no CA, nothing leaves the
  local network. Without this, it fails with "Cleartext HTTP traffic not
  permitted". All internet URLs in the code are HTTPS.

  Why allow it globally rather than for private ranges only: the `domain` tag
  takes an exact host or a name suffix, never an address mask, so listing
  "192.168.0.0" does not cover "192.168.0.79". Such a policy would fail
  silently.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
